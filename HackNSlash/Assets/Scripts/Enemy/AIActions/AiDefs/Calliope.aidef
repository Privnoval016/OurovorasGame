// Calliope.aidef  --  Prologue Miniboss: Sweeping Striker
//
// ─── INSPECTOR SETTINGS ──────────────────────────────────────────────────────
//   EnemyStateMachine:
//     actionCooldownWindow = 1.0
//     streakCap            = 4      (streak2 = 0.50, kills at threshold > 0.40)
//   EnemySensor:
//     detectionRadius = 10          (norm 1.0 = 10m)
//
// ─── DISTANCE REFERENCE ──────────────────────────────────────────────────────
//   0.20 norm =  2m   tight melee
//   0.40 norm =  4m   attack range boundary
//   0.60 norm =  6m   preferred orbit radius  ← Calliope circles here
//   0.75 norm =  7.5m outer orbit boundary
//   1.00 norm = 10m   sensor edge
//
// ─── DESIGN INTENT ───────────────────────────────────────────────────────────
//   Calliope circles at 6m (OrbitFar, radius=6.0). This is clearly outside
//   attack range so the orbit is visually readable as a "building tension" phase.
//   From orbit she commits inward via one of two paths:
//     A. ForwardLunge: peaks at 0.55 norm (5.5m), dashes into melee, hits.
//     B. StrafeReposition: variety lateral movement at mid-range.
//   After each melee attack a short PostAttackPause fires (scores 0.50 at timer
//   < 0.25 norm = 0.25s), giving the player a readable window to react.
//   Then CloseDash re-closes, and Sweep/Overhead fire with a StringMatch
//   preference ensuring they meaningfully alternate rather than tied-score spam.
//   ApproachPlayer removed: player is almost never beyond 7m during combat,
//   and OrbitFar already handles repositioning at range.

// ════════════════════════════════════════════════════════════════
// 1. Shield-Break Stun
//    Score 10 always wins while shield is depleted.
//    All other actions require IsShielded=true, so they score 0.
// ════════════════════════════════════════════════════════════════
action "CalliopeShieldBreakStunned" : EnemyStunned {
  exitCondition = ShieldRestored

  consideration composite {
    allMustBeNonZero = true
    first bool {
      key    = "bool.is_shielded"
      invert = true
    }
    rest [
      multiply: constant { value = 10 }
    ]
  }
}

// ════════════════════════════════════════════════════════════════
// 2. Post-Attack Pause  (breathing room between melee hits)
//    Scores 0.50 when timer < 0.25 norm (0.25s after last attack).
//    Beats CloseDash(0.30) and Idle(0.01) at melee range.
//    Once timer >= 0.25 this scores 0 and CloseDash/attacks take over.
//    Uses IdleStrategy duration=0.3, facePlayer=true so she stares
//    at the player during the pause rather than freezing mid-spin.
//    Only fires at melee range (dist <= 0.40) so orbit is unaffected.
// ════════════════════════════════════════════════════════════════
action "CalliopePostAttackPause" : EnemyIdle {
  duration   = 0.3
  facePlayer = true

  consideration composite {
    allMustBeNonZero = true
    first bool { key = "bool.is_shielded" }
    rest [
      multiply: bool { key = "bool.is_staggered" invert = true },
      multiply: curve {
        key    = "float.dist_to_player_norm"
        points = [[0.0, 1.0], [0.40, 1.0], [0.45, 0.0], [1.0, 0.0]]
      },
      multiply: threshold {
        key        = "float.time_since_last_action_norm"
        comparison = lessthan
        threshold  = 0.25
        iftrue     = 0.50
        iffalse    = 0.0
      }
    ]
  }
}

// ════════════════════════════════════════════════════════════════
// 3. Orbit Far
//    NO cooldown gate. Circles at radiusOverride=6.0m so she paces
//    well outside attack range -- visually predatory.
//    duration=1.2s: short enough that lunge fires quickly once its
//    0.45s cooldown has elapsed during the orbit.
//    angularSpeed=70 gives a brisk, threatening pace.
//    Scores 0.45 flat in the 0.50-0.75 norm band.
//    Scores 0 at close range so CloseDash wins there instead.
//
//    Score competition at dist=0.62, timer=0 (right after an attack):
//      OrbitFar  = 0.45
//      CloseDash = 0.00  (above 0.50 dropoff)
//      Lunge     = 0.00  (timer gate blocks until 0.45s)
//    OrbitFar wins, she circles.
//
//    Score competition at dist=0.62, timer=0.50 (cooldown elapsed):
//      OrbitFar  = 0.45
//      Lunge     = 0.72
//    Lunge wins, she commits inward.
// ════════════════════════════════════════════════════════════════
action "CalliopeOrbitFar" : EnemyMovement {
  strategy     = Orbit
  angularSpeed = 70.0
  duration     = 1.2
  radius       = 6.0

  consideration composite {
    allMustBeNonZero = true
    first bool { key = "bool.is_shielded" }
    rest [
      multiply: bool         { key = "bool.is_staggered"  invert = true },
      multiply: targetexists { key = "target.player" },
      multiply: curve {
        key    = "float.dist_to_player_norm"
        points = [[0.0, 0.0], [0.35, 0.0], [0.50, 0.35], [0.62, 0.45], [0.75, 0.45], [0.88, 0.10], [1.0, 0.0]]
      }
    ]
  }
}

// ════════════════════════════════════════════════════════════════
// 4. Close Dash  (melee-range fill)
//    NO cooldown gate. Charge strategy, capped at 0.4s.
//    Scores 0.30 flat at <= 2.5m (0.25 norm). Beats Idle(0.01).
//    Loses to PostAttackPause(0.50) for the first 0.25s after an attack.
//
//    Scenario: dist=0.20, timer=0.05  -> PostAttackPause(0.50) wins
//    Scenario: dist=0.20, timer=0.30  -> CloseDash(0.30) > Idle(0.01)
//    Scenario: dist=0.20, timer=0.40  -> Sweep(1.0) beats CloseDash
//    Scenario: dist=0.65, timer=0     -> OrbitFar(0.45) wins
// ════════════════════════════════════════════════════════════════
action "CalliopeCloseDash" : EnemyMovement {
  strategy     = Charge
  speed        = 1.6
  stopDistance = 1.5
  maxDuration  = 0.4

  consideration composite {
    allMustBeNonZero = true
    first bool { key = "bool.is_shielded" }
    rest [
      multiply: bool         { key = "bool.is_staggered"  invert = true },
      multiply: targetexists { key = "target.player" },
      multiply: curve {
        key    = "float.dist_to_player_norm"
        points = [[0.0, 0.30], [0.25, 0.30], [0.40, 0.08], [0.50, 0.0], [1.0, 0.0]]
      }
    ]
  }
}

// ════════════════════════════════════════════════════════════════
// 5. Forward Lunge  (EnemyAttack + DashLungeEnemyAttackStrategy)
//    Primary gap-closer from orbit range. Peaks at 0.55 norm (5.5m).
//    Cooldown 0.45s via TimeSinceLastAction threshold. No back-to-back.
//    After landing she is at melee range; PostAttackPause then CloseDash
//    fill the gap before Sweep unlocks.
//
//    Inspector: assign lunge EnemyAttack asset.
//    Set strategy = DashLungeEnemyAttackStrategy, dashSpeed=10, dashDuration=0.3.
//    Set animDelay on EnemyAttack to the lunge animation's commit frame.
// ════════════════════════════════════════════════════════════════
action "CalliopeForwardLunge" : EnemyAttack {
  consideration composite {
    allMustBeNonZero = true
    first bool { key = "bool.is_shielded" }
    rest [
      multiply: bool         { key = "bool.is_staggered"  invert = true },
      multiply: targetexists { key = "target.player" },
      multiply: curve {
        key    = "float.dist_to_player_norm"
        points = [[0.0, 0.0], [0.20, 0.08], [0.35, 0.45], [0.50, 0.80], [0.62, 0.72], [0.75, 0.28], [0.90, 0.04], [1.0, 0.0]]
      },
      multiply: threshold {
        key        = "float.time_since_last_action_norm"
        comparison = greaterthan
        threshold  = 0.45
        iftrue     = 1.0
        iffalse    = 0.0
      },
      multiply: threshold {
        key        = "float.same_action_streak_norm"
        comparison = greaterthan
        threshold  = 0.4
        iftrue     = 0.0
        iffalse    = 1.0
      }
    ]
  }
}

// ════════════════════════════════════════════════════════════════
// 6. Strafe Reposition  (rare variety movement)
//    Lateral sidestep at mid-range, cooldown 0.7s, blocked after
//    back-to-back. Fires roughly once per 3-4 attack cycles.
// ════════════════════════════════════════════════════════════════
action "CalliopeStrafeReposition" : EnemyMovement {
  strategy   = Strafe
  strafeSign = 1.0
  speed      = 0.8
  duration   = 0.8

  consideration composite {
    allMustBeNonZero = true
    first bool { key = "bool.is_shielded" }
    rest [
      multiply: bool         { key = "bool.is_staggered"  invert = true },
      multiply: targetexists { key = "target.player" },
      multiply: curve {
        key    = "float.dist_to_player_norm"
        points = [[0.0, 0.0], [0.20, 0.0], [0.35, 0.45], [0.55, 0.45], [0.70, 0.08], [1.0, 0.0]]
      },
      multiply: threshold {
        key        = "float.time_since_last_action_norm"
        comparison = greaterthan
        threshold  = 0.7
        iftrue     = 1.0
        iffalse    = 0.0
      },
      multiply: threshold {
        key        = "float.same_action_streak_norm"
        comparison = greaterthan
        threshold  = 0.4
        iftrue     = 0.0
        iffalse    = 1.0
      }
    ]
  }
}

// ════════════════════════════════════════════════════════════════
// 7. Sweep Attack  (primary melee -- most frequent)
//    4.0m range, 120° arc. Cooldown 0.35s. Blocked after 2x.
//    Enrage: 0.8x at full HP -> 1.2x near death.
//
//    ALTERNATION: StringMatch adds a 1.15 multiplier when Overhead
//    was the last committed action. Without this both attacks share
//    the same base score and the first action in the list always wins.
//    With it:
//      After Overhead: Sweep = 0.80 * 1.15 = 0.92 > Overhead 0.80
//      After Sweep:    Overhead gets its own 1.15 -> 0.92 > Sweep 0.80
//    They naturally alternate every time regardless of list order.
// ════════════════════════════════════════════════════════════════
action "CalliopeSweepAttack" : EnemyAttack {
  consideration composite {
    allMustBeNonZero = true
    first bool { key = "bool.is_shielded" }
    rest [
      multiply: bool         { key = "bool.is_staggered"  invert = true },
      multiply: targetexists { key = "target.player" },
      multiply: inrange {
        key      = "target.player"
        maxdist  = 4.0
        maxangle = 120.0
        points   = [[0.0, 1.0], [0.7, 1.0], [1.0, 0.0]]
      },
      multiply: threshold {
        key        = "float.time_since_last_action_norm"
        comparison = greaterthan
        threshold  = 0.35
        iftrue     = 1.0
        iffalse    = 0.0
      },
      multiply: threshold {
        key        = "float.same_action_streak_norm"
        comparison = greaterthan
        threshold  = 0.4
        iftrue     = 0.0
        iffalse    = 1.0
      },
      multiply: curve {
        key    = "float.self_health_norm"
        points = [[0.0, 1.2], [0.5, 1.0], [1.0, 0.8]]
      },
      multiply: stringmatch {
        key       = "history.last_action_name"
        match     = "CalliopeOverheadStrike"
        ifmatch   = 1.15
        ifnomatch = 1.0
      }
    ]
  }
}

// ════════════════════════════════════════════════════════════════
// 8. Overhead Strike  (secondary melee -- alternates with Sweep)
//    4.0m range, 150° arc. Cooldown 0.40s. Blocked after 2x.
//    StringMatch gives +0.15 when Sweep was last used, mirroring
//    Sweep's own bonus so the alternation is perfectly symmetric.
// ════════════════════════════════════════════════════════════════
action "CalliopeOverheadStrike" : EnemyAttack {
  consideration composite {
    allMustBeNonZero = true
    first bool { key = "bool.is_shielded" }
    rest [
      multiply: bool         { key = "bool.is_staggered"  invert = true },
      multiply: targetexists { key = "target.player" },
      multiply: inrange {
        key      = "target.player"
        maxdist  = 4.0
        maxangle = 150.0
        points   = [[0.0, 1.0], [0.7, 1.0], [1.0, 0.0]]
      },
      multiply: threshold {
        key        = "float.time_since_last_action_norm"
        comparison = greaterthan
        threshold  = 0.40
        iftrue     = 1.0
        iffalse    = 0.0
      },
      multiply: threshold {
        key        = "float.same_action_streak_norm"
        comparison = greaterthan
        threshold  = 0.4
        iftrue     = 0.0
        iffalse    = 1.0
      },
      multiply: curve {
        key    = "float.self_health_norm"
        points = [[0.0, 1.2], [0.5, 1.0], [1.0, 0.8]]
      },
      multiply: stringmatch {
        key       = "history.last_action_name"
        match     = "CalliopeSweepAttack"
        ifmatch   = 1.15
        ifnomatch = 1.0
      }
    ]
  }
}

// ════════════════════════════════════════════════════════════════
// 9. Idle Fallback
//    Score 0.01 -- loses to every real action.
// ════════════════════════════════════════════════════════════════
action "CalliopeIdleFallback" : EnemyIdle {
  consideration constant { value = 0.01 }
}





