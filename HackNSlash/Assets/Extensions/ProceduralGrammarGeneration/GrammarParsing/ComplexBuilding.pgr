// Complex Building Grammar
// Demonstrates conditional rules and probabilistic choices

/* 
 * Symbol Declarations
 * This grammar creates a facade with multiple floors,
 * where ground floors have doors and upper floors have windows
 */
symbol Facade(width: float, height: float, floors: int);
symbol Floor(width: float, height: float, floorNum: int);
symbol Window(width: float, height: float);
symbol Door(width: float, height: float);
symbol Wall(width: float, height: float);

// Main Rule: Split facade into multiple floors
// Note: All floors get same floorNum=1 to trigger upper floor rule
rule FacadeToFloors
    when Facade(width, height, floors)
    =>
    repeat(Y, floors) {
        Floor(width = width, height = height / floors, floorNum = 1)
    };

// Conditional Rule 1: Ground floor (index 0) gets doors
rule GroundFloorToDoors
    when Floor(width, height, floorNum)
    if floorNum == 0
    =>
    repeat(X, 3) {
        Door(width = width / 3, height = height)
    };

// Conditional Rule 2: Upper floors (index > 0) get windows
// Uses probabilistic choice between 5 or 3 windows
rule UpperFloorToWindows
    when Floor(width, height, floorNum)
    if floorNum > 0
    =>
    choose {
        weight 0.7: repeat(X, 5) {
            Window(width = width / 5, height = height)
        }
        weight 0.3: repeat(X, 3) {
            Window(width = width / 3, height = height)
        }
    };

// Terminal Rules: Convert windows and doors to walls
rule WindowToWall
    when Window(width, height)
    =>
    Wall(width = width, height = height);

rule DoorToWall
    when Door(width, height)
    =>
    Wall(width = width, height = height);
