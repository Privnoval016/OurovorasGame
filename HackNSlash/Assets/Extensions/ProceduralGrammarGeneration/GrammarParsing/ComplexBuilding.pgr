// Grammar: ComplexBuilding
// Axiom: Facade
// Max Iterations: 100

// === SYMBOLS ===
symbol Facade(width:float, height:float, floors:int);
symbol Floor(width:float, height:float, floorNum:int, totalFloors:int);
symbol terminal Window(width:float, height:float);
symbol terminal Door(width:float, height:float);
symbol terminal Wall(width:float, height:float);
symbol terminal FloorMarker(floorNum:int);

// === RULES ===
// Rule: FacadeToFloors - Generate all floors recursively
rule FacadeToFloors
    when Facade(width, height, floors)
    if (floors > 1)
    => Floor(width = width, height = height / floors, floorNum = floors - 1, totalFloors = floors) FloorMarker(floorNum = floors - 1) Facade(width = width, height = height, floors = floors - 1);

// Rule: FacadeToSingleFloor - Base case (last floor)
rule FacadeToSingleFloor
    when Facade(width, height, floors)
    if (floors == 1)
    => Floor(width = width, height = height, floorNum = 0, totalFloors = floors) FloorMarker(floorNum = 0);

// Rule: GroundFloorToDoors - Ground floor has 3 doors
rule GroundFloorToDoors
    when Floor(width, height, floorNum, totalFloors)
    if (floorNum == 0)
    => Door(width = width / 3, height = height) Door(width = width / 3, height = height) Door(width = width / 3, height = height);

// Rule: UpperFloorToWindows - Upper floors have 5 windows
rule UpperFloorToWindows
    when Floor(width, height, floorNum, totalFloors)
    if (floorNum > 0)
    => Window(width = width / 5, height = height) Window(width = width / 5, height = height) Window(width = width / 5, height = height) Window(width = width / 5, height = height) Window(width = width / 5, height = height);


